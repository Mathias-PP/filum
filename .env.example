# ============================================================
# Configuration Filum — fichier exemple
# ============================================================
# INSTRUCTIONS :
# 1. Copier ce fichier vers .env : cp .env.example .env
# 2. Compléter avec les vraies valeurs pour votre environnement
# 3. GÉNÉRER les secrets avec les commandes ci-dessous :
#
#    # Générer session_secret (64 caractères hex)
#    openssl rand -hex 32
#
#    # Générer master_encryption_key (64 caractères hex)
#    openssl rand -hex 32
#
# 4. NE JAMAIS commiter le fichier .env complété
# 5. Les Credentials Google OAuth doivent être créés sur Google Cloud Console
#
# ⚠️ IMPORTANT — convention de nommage (cf. ADR-010) :
# pydantic-settings tourne en case_sensitive=True. Les variables ci-dessous
# DOIVENT rester en lowercase. UPPERCASE → silent fallback aux défauts en
# Linux/CI (Windows masque le bug par accident).
# ============================================================

# === PostgreSQL (Transactionnel) ===
# Format: postgresql+asyncpg://user:password@host:port/database
database_url=postgresql+asyncpg://filum:YOUR_PASSWORD@localhost:5432/filum_dev
database_pool_size=5
database_max_overflow=10

# === Session & Crypto (OBLIGATOIRE - générer avec openssl) ===
# Ces secrets NE DOIVENT PAS être communs ou devinables
session_secret=GENERER_AVEC_openssl_rand_hex_32
master_encryption_key=GENERER_AVEC_openssl_rand_hex_32

# === OAuth Google (créer sur Google Cloud Console) ===
# https://console.cloud.google.com/apis/credentials
# Créer un OAuth 2.0 Client ID pour application Web
google_client_id=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
google_client_secret=YOUR_GOOGLE_CLIENT_SECRET
google_redirect_uri=http://localhost:8000/api/v1/auth/google/callback

# === URLs ===
frontend_base_url=http://localhost:5173
backend_base_url=http://localhost:8000
api_v1_prefix=/api/v1

# === CORS (Liste des origins autorisées en production) ===
# Format JSON array - NE PAS inclure localhost en production
cors_origins=["http://localhost:5173"]

# === Rate Limiting ===
rate_limit_per_minute=60

# === Wayback Machine (optionnel) ===
# Paire de cles S3 d'un compte archive.org, au format `access:secret`, obtenue
# sur https://archive.org/account/s3.php. Elle part en en-tete
# `Authorization: LOW access:secret`.
# Sans elle, Save Page Now n'accorde que 3 captures par minute et refuse le
# reste en `429` ; avec, 6 par minute. Mesure du 2026-08-07 sans compte :
# 493 sources en attente sur 931 publiees.
wayback_api_key=

# === Modèle de langue (optionnel — cf. .docs/17-llm-strategy.md, ADR-035) ===
# Vide = couche LLM désactivée. Concrètement : la classification des liens
# (source/promo/social/other), la suggestion d'extraits et la suggestion
# d'intitulés de morceaux ne rendent rien. Le reste du pipeline — extraction,
# Crossref, OpenAlex, découpage en extraits — n'en dépend pas.
#
# Le backend parle le dialecte OpenAI (`POST {base}/v1/chat/completions`,
# `Authorization: Bearer …`). Deux façons de le satisfaire :
#
#   a) Un proxy LiteLLM, qui résout lui-même les alias de tâche
#      (`biblio-parse`, `excerpt-suggest`, `metadata-extract`) et permet le
#      repli multi-provider. Laisser `llm_direct_model` vide.
#
#   b) Un provider directement, sans conteneur ni RAM supplémentaire — la VM
#      est une e2-micro (1 Go, backend déjà plafonné à 450 Mo). Gemini expose
#      ce dialecte nativement. Personne ne résout alors les alias :
#      `llm_direct_model` doit dire quel modèle réel les honore.
#
# Voie (b), la plus courte pour un premier utilisateur :
#   1. Créer une clé sur https://aistudio.google.com/apikey avec le compte
#      Google existant (aucun compte nouveau ; free tier largement suffisant à
#      un seul utilisateur). Seul geste qui ne peut pas être automatisé.
#   2. Renseigner les trois lignes ci-dessous.
#   3. Redémarrer le backend, puis vérifier d'un appel :
#      curl https://philum-api.duckdns.org/health/llm-diagnose
#      → "status": "ok" avec des suggestions non vides = la couche est vivante.
#
# Mesuré le 2026-08-08 : la prod ne définit aucune des trois. Ces
# fonctionnalités y sont donc inertes depuis leur livraison.
litellm_base_url=
litellm_master_key=
# Vide = alias transmis tels quels (mode proxy). Ex. : gemini-3.6-flash
llm_direct_model=
# Modèles essayés dans l'ordre quand le précédent répond 429 ou 404, séparés
# par des virgules. Le quota gratuit de Gemini se compte par modèle et par jour
# (20 appels) : sans cette liste, le vingtième appel éteint annotation,
# suggestion d'extraits, extraction de métadonnées et parsing de bibliographie
# jusqu'au lendemain, alors que la même clé répond encore ailleurs.
# Ex. : gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
llm_direct_model_fallbacks=

# === GROBID (optionnel — refs structurées des PDF importés) ===
# Space HF public par défaut (cold start ~2 min, fallback regex si indisponible).
# Le Space officiel kermitt2/grobid est PAUSED (2026-07) ; zfhxi/grobid est un
# duplicate public réveillable. Vide = désactivé. Service dédié : dupliquer
# kermitt2/grobid sur HF et pointer l'URL ici.
# grobid_base_url=https://zfhxi-grobid.hf.space

# === SvelteKit /api proxy → FastAPI backend ===
# Server-side variable read by apps/frontend/src/routes/api/[...path]/+server.ts
# Must be set on the frontend deployment (Vercel) to the public hostname
# of the FastAPI backend, e.g. https://filum-api.up.railway.app
# Required for first-party cookies (mobile Safari/iOS WebKit blocks
# cross-origin session cookies via ITP). See ADR-025.
BACKEND_URL=http://localhost:8000

# === PUBLIC_API_BASE_URL: do NOT set in production ===
# Legacy variable. The frontend now always uses a relative `/api/v1/...` path
# in the browser (routed through the SvelteKit proxy above). If you set this
# to an absolute URL in production, browser requests will bypass the proxy
# and you'll re-introduce the third-party cookie bug on mobile.
# Keep unset on Vercel. Local dev works either way (vite proxies /api anyway).
# PUBLIC_API_BASE_URL=

# === Analytics (DuckDB path) ===
duckdb_path=/data/filum_analytics.duckdb

# === Développement ===
debug=false
